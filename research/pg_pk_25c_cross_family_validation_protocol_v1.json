{
  "protocol_id": "pg-pk-25c-cross-family-validation-v1",
  "schema_version": "sift-pg25c-cross-family-validation-protocol-v1",
  "status": "preregistered_no_target_execution",
  "objective": "Validate a newly registered local lab against a frozen PG-23 or PG-24 model without source, target-instance, reset, calibration, or family leakage.",
  "upstream_contracts": {
    "pg23_report": "research/pg_pk_23_multitask_v2.json",
    "pg24_registry": "research/pg_pk_24_cross_lab_registry_v1.json",
    "pg24_protocol": "research/pg_pk_24_cross_lab_registry_protocol_v1.json",
    "frozen_before_collection": [
      "checkpoint_sha256",
      "feature_schema_version",
      "rule_ir_schema_version",
      "family_threshold",
      "margin_threshold",
      "emit_threshold",
      "known_family_set",
      "known_surface_set",
      "training_source_hashes",
      "training_target_instance_ids"
    ],
    "threshold_tuning_on_pg25c": false
  },
  "scope": {
    "protocol_design_is_offline": true,
    "target_execution_performed_by_this_protocol_commit": false,
    "future_collection_loopback_only": true,
    "external_network": false,
    "state_change_allowed": false,
    "raw_request_material_stored": false,
    "raw_response_bodies_stored": false,
    "credentials_stored": false,
    "labels_visible_to_model": false,
    "free_form_generation": false,
    "positive_authority": "bounded_local_oracle_revalidation_only"
  },
  "validation_tracks": {
    "known_family_cross_target": {
      "definition": "A family present in the frozen checkpoint is evaluated on a new source hash, new target instances, held-out surfaces, and held-out representation views.",
      "expected_behavior": "Emit a grammar-valid evidence-bound Rule IR only when the bounded oracle independently supports it; otherwise abstain.",
      "may_measure_positive_recall": true
    },
    "unseen_family_ood": {
      "definition": "A family absent from the frozen checkpoint family support is evaluated only as an unsupported family.",
      "expected_behavior": "Keep the candidate route diagnostic-only and abstain from final Rule IR emission.",
      "may_measure_positive_recall": false
    },
    "cross_family_negative": {
      "definition": "A visible surface resembles a known family while bounded evidence supports no emission or supports a different family.",
      "expected_behavior": "Do not emit the wrong family and abstain when the family/evidence gates disagree.",
      "may_measure_positive_recall": false
    }
  },
  "record_contract": {
    "required_provenance_fields": [
      "protocol_id",
      "dataset_id",
      "sample_id",
      "track",
      "source_hash",
      "container_or_fixture_digest",
      "target_instance_id",
      "sampling_seed",
      "manifest_entry_id",
      "manifest_sha256",
      "reset_receipt_hash",
      "evidence_hash"
    ],
    "required_model_fields": [
      "candidate_family",
      "family_confidence",
      "family_margin",
      "emit_probability",
      "accepted",
      "abstained"
    ],
    "required_authority_fields": [
      "expected_family_hidden",
      "oracle_revalidated",
      "oracle_support",
      "rule_ir_binding_valid",
      "false_accept",
      "local_only"
    ],
    "hash_contract": {
      "algorithm": "sha256",
      "lowercase_hex_length": 64,
      "source_hash_covers": "canonical source tree or immutable fixture manifest",
      "manifest_sha256_covers": "authorized bounded manifest entry without raw request material",
      "reset_receipt_hash_covers": "canonical reset receipt",
      "evidence_hash_covers": "canonical bounded observation and oracle projection"
    },
    "forbidden_record_fields": [
      "raw_request",
      "raw_request_body",
      "raw_response_body",
      "secret",
      "credential",
      "hidden_evaluator_state"
    ]
  },
  "isolation_policy": {
    "source_hash": {
      "new_source_hash_must_not_match_training_or_calibration": true,
      "source_hash_must_be_attested_before_collection": true,
      "same_template_with_relabeling_is_not_independent": true,
      "same_source_hash_variants_count_as_one_source": true,
      "minimum_new_source_hashes_for_pg25c_evaluation": 1,
      "minimum_distinct_source_hashes_for_memory_promotion": 3
    },
    "target_instance": {
      "minimum_independent_instances_per_source_hash": 3,
      "unattested_identifier_forbidden": true,
      "training_or_calibration_instance_overlap_allowed": false,
      "instance_identifier_reuse_across_split_allowed": false,
      "container_or_fixture_digest_required": true
    },
    "sampling_seed": {
      "minimum_seeds_per_target_instance": 2,
      "seed_must_change_manifest_selection_or_order": true,
      "renaming_identical_samples_is_not_independent": true
    },
    "group_key": [
      "source_hash",
      "target_instance_id",
      "origin_case_id"
    ],
    "split_before_augmentation": true,
    "duplicate_evidence_policy": "deduplicate_and_exclude_from_independent_denominators"
  },
  "family_isolation_policy": {
    "known_family_set_frozen_before_collection": true,
    "known_family_cross_target_rows_may_not_enter_calibration": true,
    "unseen_family_rows_may_not_enter_training_or_calibration": true,
    "unseen_family_expected_final_action": "abstain",
    "candidate_route_for_unseen_family_is_diagnostic_only": true,
    "expected_family_is_evaluator_side_only": true,
    "cross_family_negative_groups_stay_with_origin_case": true,
    "family_support_is_reported_from_frozen_checkpoint_manifest": true
  },
  "fresh_reset_policy": {
    "fresh_reset_required_before_every_independent_observation": true,
    "fresh_target_required": true,
    "reset_receipt_required": true,
    "reset_receipt_required_fields": [
      "fresh",
      "fresh_target",
      "source_hash",
      "container_or_fixture_digest",
      "target_instance_id",
      "reset_nonce_hash",
      "state_change_allowed",
      "external_network"
    ],
    "paired_views_use_separate_reset_receipts": true,
    "reset_failure_action": "invalidate_sample_and_report_engineering_failure",
    "reset_failures_count_in_model_denominator": false,
    "batch_reuse_as_independent_episode_allowed": false
  },
  "minimum_sampling_plan": {
    "diagnostic_smoke_only": {
      "target_instances": 3,
      "seeds_per_instance": 2,
      "known_family_positive_cases_per_cell": 1,
      "known_family_negative_cases_per_cell": 2,
      "independent_cases_per_known_family": 18,
      "promotion_eligible": false
    },
    "acceptance_run": {
      "target_instances": 3,
      "seeds_per_instance": 2,
      "known_family_positive_cases_per_cell": 4,
      "known_family_negative_cases_per_cell": 10,
      "independent_positive_cases_per_known_family": 24,
      "independent_negative_cases_per_known_family": 60,
      "independent_cases_per_known_family": 84,
      "unseen_family_ood_cases_per_cell": 10,
      "independent_cases_per_unseen_family": 60,
      "minimum_known_families": 1,
      "minimum_unseen_families": 1
    },
    "non_independent_diagnostics_per_cell": {
      "transport_invalid_view": 1,
      "reset_failure_view": 1,
      "count_toward_statistical_denominator": false
    },
    "negative_control_allocation_per_known_family_cell": {
      "clean_baseline": 3,
      "same_surface_without_oracle_support": 3,
      "cross_family_surface": 2,
      "alternate_surface_clean_control": 2,
      "total_independent_negatives": 10
    },
    "representation_views": {
      "minimum_views_per_origin_case": 2,
      "views_do_not_increase_independent_case_count": true,
      "grouped_with_origin_case": true
    }
  },
  "abstention_and_acceptance_gates": {
    "global_fail_closed": {
      "missing_source_hash": "reject_run",
      "missing_target_instance_id": "reject_run",
      "missing_or_failed_reset": "invalidate_sample",
      "missing_oracle_revalidation": "abstain",
      "invalid_rule_ir_binding": "abstain",
      "unsupported_family": "abstain",
      "family_evidence_disagreement": "abstain"
    },
    "known_family_cross_target": {
      "unsafe_accept_count_max": 0,
      "negative_false_accept_count_max": 0,
      "accepted_family_error_count_max": 0,
      "aggregate_positive_recall_min": 0.60,
      "per_target_positive_recall_min": 0.50,
      "per_seed_positive_recall_min": 0.50,
      "seed_recall_range_max": 0.15,
      "rule_ir_binding_valid_rate": 1.0,
      "emission_without_oracle_support_count_max": 0
    },
    "unseen_family_ood": {
      "final_abstain_rate_min": 0.95,
      "per_target_final_abstain_rate_min": 0.90,
      "rule_ir_emission_count_max": 0,
      "unsafe_accept_count_max": 0
    },
    "cross_family_negative": {
      "wrong_family_emission_count_max": 0,
      "family_evidence_disagreement_abstain_rate": 1.0
    },
    "calibration": {
      "emit_ece_max": 0.05,
      "family_ece_max": 0.08,
      "thresholds_must_equal_frozen_upstream_values": true,
      "posthoc_threshold_selection_allowed": false
    },
    "statistical_risk": {
      "minimum_independent_negative_count": 60,
      "required_observed_false_accept_count": 0,
      "one_sided_confidence_level": 0.95,
      "false_accept_upper_bound_max": 0.05,
      "method": "exact_clopper_pearson",
      "zero_event_upper_bound_at_n_60": 0.048703
    }
  },
  "statistical_reporting": {
    "primary_unit": "independent_origin_case",
    "required_breakdowns": [
      "track",
      "expected_family_hidden",
      "candidate_family",
      "source_hash",
      "target_instance_id",
      "sampling_seed",
      "negative_control_kind"
    ],
    "required_counts": [
      "collected",
      "valid_after_reset_checks",
      "deduplicated",
      "reset_failures",
      "oracle_supported",
      "accepted",
      "abstained",
      "false_accepts",
      "family_errors",
      "valid_rule_ir_bindings"
    ],
    "required_rates": [
      "positive_recall",
      "negative_false_accept_rate",
      "unsafe_accept_rate",
      "final_abstain_rate",
      "family_error_rate_accepted",
      "rule_ir_binding_valid_rate",
      "emit_ece",
      "family_ece"
    ],
    "confidence_intervals": {
      "binomial_rates": "wilson_95",
      "zero_false_accept_gate": "one_sided_exact_clopper_pearson_95"
    },
    "seed_summary": [
      "minimum",
      "median",
      "maximum",
      "range"
    ],
    "report_must_include": [
      "frozen_checkpoint_sha256",
      "frozen_thresholds",
      "training_source_hashes",
      "training_target_instance_ids",
      "new_source_hashes",
      "new_target_instance_ids",
      "reset_receipt_hash_count",
      "evidence_hash_count",
      "invalid_sample_reasons",
      "gate_results",
      "engineering_failure_count"
    ],
    "all_failures_reported_without_exclusion": true
  },
  "pg23_pg24_integration": {
    "pg23_input_adapter": {
      "reuse_fields": [
        "response_projection",
        "oracle_projection",
        "semantic.family",
        "semantic.surface",
        "rule_ir_result"
      ],
      "labels_remain_evaluator_side": true,
      "pg25c_thresholds_are_read_only": true,
      "accepted_output_requires_grammar_valid_rule_ir": true,
      "accepted_output_requires_evidence_binding": true
    },
    "pg24_registry_transition": {
      "initial_training_role": "cross_family_evaluation_only",
      "pass_status": "eligible_for_separate_training_cohort_collection",
      "automatic_training_eligibility_on_pass": false,
      "automatic_memory_promotion_on_pass": false,
      "acceptance_cohort_may_later_enter_training": false,
      "fresh_source_and_target_cohort_required_for_training": true
    },
    "memory_promotion_contract": {
      "minimum_distinct_datasets": 3,
      "minimum_distinct_source_hashes": 3,
      "minimum_target_instances": 3,
      "minimum_sampling_seeds_per_dataset": 2,
      "oracle_revalidation_required": true,
      "zero_false_accept_required": true,
      "pg25c_acceptance_alone_is_sufficient": false
    }
  },
  "run_outcomes": {
    "pass": "All provenance, reset, sampling, abstention, accuracy, calibration, and statistical gates pass on the frozen model.",
    "diagnostic_only": "Infrastructure is valid but sample support or a performance gate is insufficient; no training or memory promotion follows.",
    "engineering_invalid": "Source, target, reset, manifest, or evidence integrity failed; model metrics are not interpreted.",
    "model_rejected": "Infrastructure is valid and one or more preregistered model gates failed."
  }
}
