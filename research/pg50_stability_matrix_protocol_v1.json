{
  "schema_version": "pg-pk-50-stability-matrix-protocol-v1",
  "protocol_id": "PG-50",
  "title": "多实现、多种子、多表面 GET/POST 泛化稳定性矩阵",
  "objective": "在三套独立 HTTP 布局、五个采样种子、三种响应封装和十个语义表面上，训练 pre-probe action-value head 只使用 semantic/channel/action/belief，并对未参与训练的 frost/quartz 实现进行正负 oracle、未知族 abstain 与跨矩阵稳定性验收。",
  "authorization": {
