    "collection_engineering_note": "sequential collector exceeded the five-minute budget; bounded worker-port allocation was added, and a first parallel run failed due modulo-port collision before producing artifacts; the final run used one fixed port per worker and completed"
  },
  "ablation_result": {
    "script": "scripts/train_pg37_representation_ablation.py",
    "report": "research/pg37_representation_ablation_report_v1.json",
    "device": "cuda",
