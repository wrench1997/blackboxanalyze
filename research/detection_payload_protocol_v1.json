{
  "schema_version": "sift-detection-payload-v1",
  "purpose": "AI 输出仅用于授权范围内的无副作用检测请求描述，不包含利用器或自动执行器。",
  "allowed_methods": ["GET", "HEAD", "OPTIONS"],
  "target_scope": "local_only",
  "required_fields": ["target", "method", "path", "probe_kind", "probe", "marker", "expected", "safety", "payload_sha256"],
  "probe_kinds": ["http_canary", "header_canary", "inert_dom_markup", "encoded_dom_markup", "sql_fragment_class", "sql_channel_class"],
  "expected_evidence": [
    "status_class",
    "response_shape",
    "location_origin",
    "dom_change",
    "interpreter_boundary",
    "timing_bucket",
    "error_channel"
  ],
  "forbidden": [
    "script_execution",
    "credential_access",
    "database_write",
    "data_exfiltration",
    "external_callback",
    "destructive_method",
    "evaluator_metadata"
  ],
  "lifecycle": [
    "validate_scope",
    "record_baseline",
    "emit_detection_payload_manifest",
    "execute_only_in_authorized_runner",
    "compare_observable_evidence",
    "repeat_on_fresh_or_same_condition",
    "persist_hash_chained_result"
  ],
  "implementation": {
    "validator": "app/detection_payload.py",
    "run_binding": "app/maze_engine.py",
    "api": "/api/maze/detection-payload"
  }
}
