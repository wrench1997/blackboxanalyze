    "decoder_input": ["sign-binned shape delta and change bits", "bounded semantic reference one-hot"],
    "typed_oracle_is_target_only": true,
    "excluded": ["family", "positive", "positive_authority", "evidence_sha256", "source_id", "target_instance_id", "raw_probe", "raw_response_body"],
    "online_weight_update": false,
    "long_term_memory_write": false
  },
  "promotion_gate": {
